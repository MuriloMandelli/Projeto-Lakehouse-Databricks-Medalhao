# SQL Server local (container lakehouse-sqlserver) — banco de origem
DB_SERVER=localhost
DB_PORT=1434
DB_USER=sa
DB_PASSWORD=SqlServer@2025!
DB_DATABASE=LojaDB

# Databricks Free Edition (opcional: só para enviar os CSV pelo notebook 01)
# HOST: endereço do seu workspace, ex.: https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
# TOKEN: crie em Settings > Developer > Access tokens (nunca suba este arquivo para o GitHub)
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# Onde os CSV serão gravados no Databricks: /Volumes/<catalogo>/landing/dados
DATABRICKS_CATALOGO=workspace
